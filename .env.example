# Copy to .env and adjust. Values here are safe development defaults.

# Generate a new one for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-dev-key-change-me-in-production

# Set to 0 in production.
DJANGO_DEBUG=1

# Comma-separated hostnames Django will serve (production).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins for CSRF when behind a domain (e.g. https://laaclab.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# allauth email verification: none | optional | mandatory
ACCOUNT_EMAIL_VERIFICATION=none

# Force HTTPS redirect in production (nginx terminates TLS).
DJANGO_SECURE_SSL_REDIRECT=1
