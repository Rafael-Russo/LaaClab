# Copy to .env and adjust. Values here are safe development defaults.

# Generate a new one for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-dev-key-change-me-in-production

# Set to 0 in production.
DJANGO_DEBUG=1

# Comma-separated hostnames Django will serve (production).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins for CSRF when behind a domain (e.g. https://laaclab.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database. Leave unset to use a local SQLite file (no server needed).
# MySQL (docker compose / production):
#   DATABASE_URL=mysql://laaclab:laaclab@db:3306/laaclab
DATABASE_URL=

# Skip demo-data seeding on container start with 0.
SEED_ON_START=1

# Celery broker/result backend (Redis).
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Celery result backend (defaults to the broker if unset).
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Enable the optional periodic ingestion refresh (Celery Beat). Off by default.
INGEST_SCHEDULE_ENABLED=0

# Bug-report classifier: embedding (local model, downloads ~220MB on first
# use) | fake (no download; used in CI/offline/tests).
BUGS_CLASSIFIER=embedding

# allauth email verification: none | optional | mandatory
ACCOUNT_EMAIL_VERIFICATION=none

# Force HTTPS redirect in production (nginx terminates TLS).
DJANGO_SECURE_SSL_REDIRECT=1

# Web Push (VAPID). Empty = push disabled. Generate a pair with:
#   ./.venv/Scripts/python.exe manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@laaclab.example

# --- Flask (migration in progress; coexists with DJANGO_* until slice 7) ---

# Which config to load: dev | prod | test. Set to prod in production.
APP_CONFIG=dev

# Flask session key. Required when APP_CONFIG=prod (boot fails without it).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=flask-insecure-dev-key-change-me-in-production

# Hostnames accepted in the Host header (equivalent to DJANGO_ALLOWED_HOSTS).
# Must not be empty when APP_CONFIG=prod (boot fails without it).
ALLOWED_HOSTS=localhost,127.0.0.1

# Trust X-Forwarded-* headers from the reverse proxy in front of the app
# (deploy/nginx.conf already sends them). Only turn this on when there
# really is a proxy in front — otherwise a client can forge the headers.
TRUSTED_PROXY=0

# Force HTTPS redirect (equivalent to DJANGO_SECURE_SSL_REDIRECT).
SSL_REDIRECT=0

# Seconds for the Strict-Transport-Security header; 0 disables it
# (equivalent to DJANGO_SECURE_HSTS_SECONDS).
HSTS_SECONDS=0

# Seconds before recycling a SQLAlchemy pool connection (equivalent to
# DJANGO_CONN_MAX_AGE). Default: 600.
DB_POOL_RECYCLE=600

# Run Celery tasks synchronously in the caller's process — no worker or
# broker needed. The test suite forces this on regardless of this value.
CELERY_TASK_ALWAYS_EAGER=0

# Outgoing mail (Flask-Mail), equivalent to Django's EMAIL_* settings.
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_TLS=0
MAIL_USERNAME=
MAIL_PASSWORD=
# Suppress sending entirely (nothing is sent, nothing is printed). Defaults
# to on everywhere except APP_CONFIG=prod.
MAIL_SUPPRESS_SEND=1
# Default sender for verification/reset emails.
MAIL_DEFAULT_SENDER=nao-responda@laaclab.example
